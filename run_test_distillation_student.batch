#!/bin/bash
#SBATCH --job-name=test_distill_student
#SBATCH --output=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/test_distill_student_%j.out
#SBATCH --error=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/test_distill_student_%j.err
#SBATCH --partition=prod10
#SBATCH --gres=gpu:nvidia_a100_1g.10gb:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=15G
#SBATCH --time=1:0:0

set -e
PROJECT=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab
cd "$PROJECT"
[ -f "$PROJECT/.venv/bin/activate" ] && source "$PROJECT/.venv/bin/activate"
export PYTHONPATH="$PROJECT:${PYTHONPATH:-}"
mkdir -p logs

run_sweep() {
    local label=$1; local ckpt=$2
    echo ""
    echo "############################################################"
    echo "  $label"
    echo "  $ckpt"
    echo "############################################################"
    python -u src/test/threshold_sweep.py \
        --checkpoint "$ckpt" \
        --model distillation_student \
        --data_dir data/datasets \
        --datasets ORIGA G1020_TEST:test \
        --batch_size 32 --num_workers 2
}

echo "======================================================"
echo "  Job: $SLURM_JOB_ID  |  $(date)"
echo "======================================================"

run_sweep "v0 — ancien student (3 teachers, incl. huge)" \
    "checkpoints/distillation/student/version_0/distill_v0-epoch=14-val_auc=0.9882.ckpt"

run_sweep "v1 — nouveau student (2 teachers, sans huge)" \
    "checkpoints/distillation/student/version_1/distill_v1-epoch=22-val_auc=0.9880.ckpt"

echo ""
echo "  End: $(date)"
