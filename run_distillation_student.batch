#!/bin/bash
#SBATCH --job-name=distill_student
#SBATCH --output=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/distill_student_%j.out
#SBATCH --error=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/distill_student_%j.err
#SBATCH --partition=prod40
#SBATCH --gres=gpu:nvidia_a100_3g.40gb:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=24:0:0

set -e

PROJECT=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab
cd "$PROJECT"

[ -f "$PROJECT/.venv/bin/activate" ] && source "$PROJECT/.venv/bin/activate"

mkdir -p logs checkpoints/distillation/student results

# ── Resolve best teacher checkpoints automatically ────────────────────────────
# Each teacher ModelCheckpoint saves to checkpoints/teachers/<model>/version_<N>/
# We pick the latest version and find the best checkpoint (highest val_auc in filename).

find_best_ckpt() {
    local model_dir="checkpoints/teachers/$1"
    # Latest version directory
    local version_dir
    version_dir=$(ls -td "$model_dir"/version_* 2>/dev/null | head -1)
    if [ -z "$version_dir" ]; then
        echo ""
        return
    fi
    # Checkpoint with highest val_auc in filename (exclude last.ckpt)
    ls "$version_dir"/*.ckpt 2>/dev/null \
        | grep -v "last.ckpt" \
        | sort -t'=' -k3 -rn \
        | head -1
}

CKPT_EVA=$(find_best_ckpt "eva02_large")
CKPT_LARGE=$(find_best_ckpt "dinov3_large")

echo "======================================================"
echo "  Job ID     : $SLURM_JOB_ID"
echo "  Node       : $(hostname)"
echo "  GPU        : $CUDA_VISIBLE_DEVICES"
echo "  Start time : $(date)"
echo "  Student    : DINOv3-Small (distilled)"
echo "  T1 (EVA02) : ${CKPT_EVA:-NOT FOUND}"
echo "  T2 (Large) : ${CKPT_LARGE:-NOT FOUND}"
echo "======================================================"

python -u src/distillation/train.py \
    --ckpt_eva02_large  "${CKPT_EVA:-}" \
    --ckpt_dinov3_large "${CKPT_LARGE:-}" \
    --data_dir data/datasets \
    --batch_size 8 \
    --image_size 448 \
    --max_epochs 60 \
    --lr 1e-4 \
    --weight_decay 1e-4 \
    --num_workers 4 \
    --temperature 4.0 \
    --arcface_margin 0.3 \
    --arcface_scale 32.0 \
    --alpha 1.0 \
    --beta 1.0 \
    --gamma 1.0 \
    --phase1_epochs 5 \
    --warmup_epochs_p2 5 \
    --unfreeze_backbone_epoch 3 \
    --precision 16-mixed \
    --checkpoint_dir checkpoints/distillation/student

echo "======================================================"
echo "  Distillation done."
echo "  End time : $(date)"
echo "======================================================"
