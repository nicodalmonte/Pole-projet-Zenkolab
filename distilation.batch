#!/bin/bash
#
#SBATCH --job-name=student_distill
#SBATCH --output=/raid/home/students/sousa_mar/P-le-Projet-Zenkolab/logs/distill_%j.out
#SBATCH --error=/raid/home/students/sousa_mar/P-le-Projet-Zenkolab/logs/distill_%j.out

## Partition: prod10 | prod20 | prod40 | prod80
#SBATCH --partition=prod80

## GPU: nvidia_a100_1g.10gb | nvidia_a100_3g.40gb | nvidia_a100-sxm4-80gb
#SBATCH --gres=gpu:nvidia_a100-sxm4-80gb:1

## ntasks * cpus-per-task must be in [1 : 4 * nMIG]  (nMIG=4 for prod40)
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16

## RAM
#SBATCH --mem=32G

## Max wall time
#SBATCH --time=24:0:0

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------

PROJECT=/raid/home/students/sousa_mar/P-le-Projet-Zenkolab
TEACHER_CKPT=$PROJECT/checkpoints/version_9/dinov3_1_v9-epoch=14-val_auc=0.9271.ckpt

cd "$PROJECT"

echo "======================================================"
echo "  Job ID         : $SLURM_JOB_ID"
echo "  Node           : $(hostname)"
echo "  GPU(s)         : $CUDA_VISIBLE_DEVICES"
echo "  Python         : $(python --version)"
echo "  Teacher ckpt   : $TEACHER_CKPT"
echo "  Start time     : $(date)"
echo "======================================================"

# Optional: fail early if checkpoint does not exist
if [ ! -f "$TEACHER_CKPT" ]; then
    echo "ERROR: teacher checkpoint not found at $TEACHER_CKPT"
    exit 1
fi

# ---------------------------------------------------------------------------
# Distillation training
# ---------------------------------------------------------------------------

uv run src/distilation/distilation.py \
    --data_dir data/datasets \
    --teacher_ckpt checkpoints/version_9/dinov3_1_v9-epoch=14-val_auc=0.9271.ckpt \
    --teacher_backbone vit_huge_plus_patch16_dinov3.lvd1689m \
    --student_backbone vit_small_plus_patch16_dinov3.lvd1689m \
    --batch_size 32 \
    --precision 32 \
    --image_size 224 \
    --kd_alpha 0.15 \
    --kd_temperature 4.0 \
    --max_epochs 50 \
    --checkpoint_dir checkpoints_student

echo "======================================================"
echo "  End time : $(date)"
echo "======================================================"