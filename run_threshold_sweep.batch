#!/bin/bash
#SBATCH --job-name=threshold_sweep
#SBATCH --output=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/threshold_sweep_%j.out
#SBATCH --error=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/threshold_sweep_%j.err
#SBATCH --partition=prod10
#SBATCH --gres=gpu:nvidia_a100_1g.10gb:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=15G
#SBATCH --time=0:30:0

set -e

PROJECT=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab
cd "$PROJECT"

[ -f "$PROJECT/.venv/bin/activate" ] && source "$PROJECT/.venv/bin/activate"

export PYTHONPATH="$PROJECT:${PYTHONPATH:-}"

mkdir -p logs

DATASETS="ORIGA G1020_TEST:test REFUGE2:test"

echo "======================================================"
echo "  Job ID     : $SLURM_JOB_ID"
echo "  Node       : $(hostname)"
echo "  Start time : $(date)"
echo "======================================================"

echo ""
echo "############################################################"
echo "  Student — DINOv3-Small (distillation)"
echo "############################################################"
python -u src/test/threshold_sweep.py \
    --checkpoint checkpoints/distillation/student/version_0/distill_v0-epoch=14-val_auc=0.9882.ckpt \
    --model distillation_student \
    --data_dir data/datasets \
    --datasets $DATASETS \
    --batch_size 32 --num_workers 2

echo ""
echo "############################################################"
echo "  Teacher — DINOv3-Large"
echo "############################################################"
python -u src/test/threshold_sweep.py \
    --checkpoint checkpoints/teachers/dinov3_large/version_3/dinov3_large_v3-epoch=29-val_auc=0.9875.ckpt \
    --model dinov3_large \
    --data_dir data/datasets \
    --datasets $DATASETS \
    --batch_size 32 --num_workers 2

echo ""
echo "############################################################"
echo "  Teacher — EVA02-Large"
echo "############################################################"
python -u src/test/threshold_sweep.py \
    --checkpoint checkpoints/teachers/eva02_large/version_4/eva02_large_v4-epoch=02-val_auc=0.9437.ckpt \
    --model eva02_large \
    --data_dir data/datasets \
    --datasets $DATASETS \
    --batch_size 16 --num_workers 2

echo ""
echo "  End time : $(date)"
