#!/bin/bash
#SBATCH --job-name=test_eva02
#SBATCH --output=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/test_eva02_%j.out
#SBATCH --error=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab/logs/test_eva02_%j.err
#SBATCH --partition=prod10
#SBATCH --gres=gpu:nvidia_a100_1g.10gb:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=15G
#SBATCH --time=1:0:0

set -e

PROJECT=/raid/home/students/goldrajch_dav/projectEYE/P-le-Projet-Zenkolab
cd "$PROJECT"

[ -f "$PROJECT/.venv/bin/activate" ] && source "$PROJECT/.venv/bin/activate"

export PYTHONPATH="$PROJECT:${PYTHONPATH:-}"

mkdir -p logs

CKPT=checkpoints/teachers/eva02_large/version_4/last.ckpt

echo "======================================================"
echo "  Job ID     : $SLURM_JOB_ID"
echo "  Node       : $(hostname)"
echo "  GPU        : $CUDA_VISIBLE_DEVICES"
echo "  Start time : $(date)"
echo "  Checkpoint : $CKPT"
echo "======================================================"

echo ""
echo "============================================================"
echo "  [1/3] ORIGA (all)"
echo "============================================================"
python -u src/test/test_checkpoint_on_datasets.py \
    --checkpoint "$CKPT" \
    --model eva02_large \
    --data_dir data/datasets \
    --datasets ORIGA \
    --batch_size 16 \
    --num_workers 2 \
    --precision 16-mixed

echo ""
echo "============================================================"
echo "  [2/3] G1020 (test split)"
echo "============================================================"
python -u src/test/test_checkpoint_on_datasets.py \
    --checkpoint "$CKPT" \
    --model eva02_large \
    --data_dir data/datasets \
    --datasets G1020_TEST:test \
    --batch_size 16 \
    --num_workers 2 \
    --precision 16-mixed

echo ""
echo "============================================================"
echo "  [3/3] REFUGE2 (test split)"
echo "============================================================"
python -u src/test/test_checkpoint_on_datasets.py \
    --checkpoint "$CKPT" \
    --model eva02_large \
    --data_dir data/datasets \
    --datasets REFUGE2:test \
    --batch_size 16 \
    --num_workers 2 \
    --precision 16-mixed

echo ""
echo "======================================================"
echo "  All evaluations done."
echo "  End time : $(date)"
echo "======================================================"
